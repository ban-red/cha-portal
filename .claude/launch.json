{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "s1-server",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--release",
        "-p",
        "s1-server",
        "--",
        "--streams",
        "spikes/s1c-codec-compare/streams"
      ],
      "port": 4480
    },
    {
      "name": "s1-web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "spikes/s1-browser-pyrowave/web",
        "dev"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "s1b-web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "spikes/s1b-pyrowave-webgpu/web",
        "dev"
      ],
      "port": 5181,
      "autoPort": true
    },
    {
      "name": "s1c-web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "spikes/s1c-codec-compare/web",
        "dev"
      ],
      "port": 5182,
      "autoPort": true
    },
    {
      "name": "cha-control",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "-p",
        "cha-control",
        "--",
        "--listen",
        "127.0.0.1:7677",
        "--database",
        "data/dev.db",
        "--web-dir",
        "web/apps/portal/dist"
      ],
      "port": 7677
    },
    {
      "name": "portal",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "web/apps/portal",
        "dev"
      ],
      "port": 7678,
      "autoPort": true
    },
    {
      "name": "portal-dev",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "CHA_LISTEN=0.0.0.0:7677",
        "bun",
        "run",
        "dev"
      ],
      "port": 7678,
      "autoPort": false
    },
    {
      "name": "s7-web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "spikes/s7-wan/web",
        "dev"
      ],
      "port": 5191
    },
    {
      "name": "s8-rfi",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5192",
        "--bind",
        "127.0.0.1",
        "--directory",
        "spikes/s8-rfi"
      ],
      "port": 5192
    }
  ]
}
