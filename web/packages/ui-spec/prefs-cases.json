    {"name": "opacity above 100 is lowered", "group": "stats_panel", "value": {"opacity": 250}, "expect": {"opacity": 100}},
    {"name": "opacity far above 100", "group": "stats_panel", "value": {"opacity": 1000000000.0}, "expect": {"opacity": 100}},
