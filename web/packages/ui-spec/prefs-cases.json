    {"name": "old shape: before snap and pos", "group": "stats_panel", "value": {"open": true, "compact": false, "collapsed": false, "corner": "bottom-left", "folded": ["stream"], "opacity": 80}, "expect": {"corner": "bottom-left", "folded": ["stream"], "opacity": 80}},
    {"name": "opacity written as a whole float", "group": "stats_panel", "text": "{\"opacity\": 70.0}", "expect": {"opacity": 70}},
