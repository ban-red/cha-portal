    {"name": "opacity at 100", "group": "stats_panel", "value": {"opacity": 100}, "expect": {"opacity": 100}},
    {"name": "opacity rounds a half up", "group": "stats_panel", "value": {"opacity": 55.5}, "expect": {"opacity": 56}},
