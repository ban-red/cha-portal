    {"name": "opacity null", "group": "stats_panel", "value": {"opacity": null}, "expect": {}},
    {"name": "folded keeps spec order, once each, drops unknown ids", "group": "stats_panel", "value": {"folded": ["node", "stream", "node", "bogus", "Stream"]}, "expect": {"folded": ["stream", "node"]}},
    {"name": "folded drops entries that are not strings", "group": "stats_panel", "value": {"folded": [1, null, "latency", {"a": 1}]}, "expect": {"folded": ["latency"]}},
    {"name": "folded can hold every section", "group": "stats_panel", "value": {"folded": ["node", "network", "latency", "stream"]}, "expect": {"folded": ["stream", "latency", "network", "node"]}},
