{
  "notes": "Shared toolbar cases. Each gives the capabilities a session reports (a name from caps, or a list), the state laid over defaults.state, and what both players must build: whether the bar is up, exactly which controls show, some fields of the ones named in pin, the open menu's rows, the countdown. A case with no platforms runs on both players; where their wording differs, expect is { web, native }.",
  "caps": {
    "web-portal": [
      "share", "gpu-badge", "viewers", "control-handoff", "hand-controls", "fps-change", "steam-overlay",
      "codec-switch", "transport-switch", "probe", "sound-restart", "controllers-connect"
    ],
    "web-no-webtransport": [
      "share", "gpu-badge", "viewers", "control-handoff", "hand-controls", "fps-change", "codec-switch",
      "sound-restart", "controllers-connect"
    ],
    "native-portal": ["viewers", "control-handoff", "fps-change", "steam-overlay", "sound-restart"],
    "native-moonlight": ["sound-restart"]
  },
  "defaults": {
    "state": {
      "connected": true,
      "captured": false,
      "expanded": true,
      "hover": false,
      "menu_open": "",
      "countdown": null,
      "title": "Google Chrome",
      "viewers": 1,
      "has_control": true,
      "fps": 60,
      "overlay": null,
      "mouse_on": true,
      "muted": false,
      "volume": 100,
      "controllers": [],
      "fullscreen": false,
      "stats_open": true,
      "grade": "A",
      "grade_summary": "Smooth"
    },
    "web": {
      "gpu_kind": "nvidia",
      "watchers": [],
      "codecs": ["h264", "hevc", "av1"],
      "codec": "h264",
      "pyrowave": false,
      "fixed_size": false,
      "fps_switching": false,
      "overlay_switching": false,
      "transport_choice": "auto",
      "transport_via": "webtransport",
      "probing": false,
      "recapture": false,
      "audio_blocked": false,
      "hid_reason": "",
      "note": ""
    },
    "native": { "codec": "HEVC", "transport_name": "Cha Portal", "transport_tag": "WT", "input_denied": false }
  },
  "cases": [
    {
      "name": "web: a full portal session shows every control",
      "platforms": ["web"],
      "caps": "web-portal",
      "state": {
        "viewers": 3,
        "overlay": "2",
        "watchers": [
          { "id": "a", "label": "Guest controller", "can_hand": true },
          { "id": "b", "label": "Guest viewer", "can_hand": false }
        ],
        "controllers": [{ "name": "DualSense Wireless Controller", "slot": 0 }],
        "grade": "B",
        "grade_summary": "Minor stutter"
      },
      "expect": {
        "visible": true,
        "controls": [
          "back", "power", "share", "name", "gpu", "viewers", "watchers", "stream", "capture", "mouse", "sound",
          "controllers", "fullscreen", "stats"
        ],
        "pin": {
          "back": { "label": "← Back", "tooltip": "Back to the dashboard (it keeps running)" },
          "power": {
            "icon": "power",
            "aria_label": "Power off",
            "tooltip": "Power off this app (a 5 second countdown, which you can cancel)",
            "hover_tone": "danger"
          },
          "share": {
            "icon": "share",
            "aria_label": "Share",
            "tooltip": "Invite a friend to watch, play or use the controls"
          },
          "name": { "label": "Google Chrome" },
          "gpu": { "droppable": false },
          "viewers": { "label": "3 watching", "tooltip": "3 sessions are watching this environment" },
          "watchers": {
            "aria_label": "Who is watching",
            "items": [
              {
                "text": "Guest controller",
                "detail": null,
                "id": "a",
                "action": {
                  "label": "Hand controls",
                  "tooltip": "Hand this guest the keyboard and mouse. You can take them back."
                }
              },
              { "text": "Guest viewer", "detail": null, "id": "b", "action": null }
            ]
          },
          "stream": {
            "icon": "stream-settings",
            "aria_label": "Stream settings",
            "tooltip": "Stream settings: codec, frame rate, transport",
            "active": false,
            "menu_dom_id": "stream-menu"
          },
          "capture": {
            "icon": "exclusive-input",
            "aria_label": "Exclusive input",
            "tooltip": "Exclusive input: the mouse is captured for games; Esc releases it (hold Esc in full screen on Chrome)",
            "pressed": false,
            "disabled": false
          },
          "mouse": {
            "icon": "mouse-on",
            "aria_label": "Turn the mouse off",
            "tooltip": "Mouse on: click to stop sending the mouse (the keyboard still works)",
            "pressed": false
          },
          "sound": { "icon": "sound-on", "aria_label": "Sound on", "tooltip": "Sound on, volume 100%", "tone": "none" },
          "controllers": {
            "aria_label": "Controllers, 1 sending input",
            "tooltip": "1 controller(s) sending input",
            "tone": "accent",
            "badge": { "text": "1", "tone": "accent", "tooltip": null }
          },
          "fullscreen": { "icon": "fullscreen-enter", "aria_label": "Full screen", "tooltip": "Full screen" },
          "stats": {
            "icon": "stats",
            "aria_label": "Stats",
            "tooltip": "Hide the stats panel",
            "pressed": true,
            "tone": "accent",
            "badge": { "text": "B", "tone": "ok", "tooltip": "Stream health: Minor stutter" }
          }
        }
      }
    },
    {
      "name": "native: a full portal session",
      "platforms": ["native"],
      "caps": "native-portal",
      "state": {
        "viewers": 2,
        "overlay": "2",
        "controllers": [{ "name": "DualSense Wireless Controller", "slot": 0 }, { "name": "Steam Controller", "slot": 1 }],
        "grade": "B",
        "grade_summary": "Minor stutter"
      },
      "expect": {
        "visible": true,
        "controls": [
          "back", "power", "name", "viewers", "stream", "capture", "mouse", "sound", "controllers", "fullscreen",
          "stats"
        ],
        "pin": {
          "back": { "label": "← Back", "tooltip": "Back to the dashboard (it keeps running)" },
          "power": {
            "icon": "power",
            "aria_label": "Power off",
            "tooltip": "Power off this app (a 5 second countdown, which you can cancel)",
            "hover_tone": "danger"
          },
          "name": { "label": "Google Chrome", "droppable": true },
          "viewers": { "label": "2 watching", "tooltip": "2 sessions are watching this app", "droppable": true },
          "stream": { "icon": "stream-settings", "tooltip": "Stream settings: codec, frame rate, transport" },
          "capture": {
            "icon": "exclusive-input",
            "tooltip": "Exclusive input: capture the mouse for games. Ctrl+Alt+Shift+T lets it go"
          },
          "mouse": {
            "icon": "mouse-on",
            "tooltip": "Mouse on: click to stop sending the mouse (the keyboard still works)"
          },
          "sound": { "icon": "sound-on", "tooltip": "Sound on, volume 100%" },
          "controllers": {
            "tooltip": "2 controller(s) sending input",
            "tone": "accent",
            "badge": { "text": "2", "tone": "accent", "tooltip": null }
          },
          "fullscreen": { "icon": "fullscreen-enter", "tooltip": "Full screen (Cmd+Ctrl+F)" },
          "stats": {
            "tooltip": "Hide the stats panel",
            "badge": { "text": "B", "tone": "ok", "tooltip": "Stream health: Minor stutter" }
          }
        }
      }
    },
    {
      "name": "native: Moonlight reports few capabilities",
      "platforms": ["native"],
      "caps": "native-moonlight",
      "state": { "viewers": null, "has_control": true, "fps": 60, "grade": "", "grade_summary": "" },
      "expect": {
        "visible": true,
        "controls": ["back", "power", "name", "stream", "capture", "mouse", "sound", "controllers", "fullscreen", "stats"],
        "pin": { "stats": { "badge": null } }
      }
    },
    {
      "name": "web: a session viewing, without the controls",
      "platforms": ["web"],
      "caps": "web-portal",
      "state": {
        "has_control": false,
        "viewers": 2,
        "watchers": [{ "id": "a", "label": "Guest controller", "can_hand": true }]
      },
      "expect": {
        "visible": true,
        "controls": [
          "back", "power", "share", "name", "gpu", "viewers", "take-control", "stream", "capture", "mouse",
          "sound", "controllers", "fullscreen", "stats"
        ],
        "pin": {
          "take-control": {
            "label": "Viewing · Take back",
            "tooltip": "Someone else has the keyboard and mouse; take them back",
            "tone": "accent"
          }
        }
      }
    },
    {
      "name": "native: a session viewing, with its stream settings open",
      "platforms": ["native"],
      "caps": "native-portal",
      "state": { "has_control": false, "viewers": 2, "menu_open": "stream", "overlay": "1" },
      "expect": {
        "visible": true,
        "controls": [
          "back", "power", "name", "viewers", "take-control", "stream", "capture", "mouse", "sound",
          "controllers", "fullscreen", "stats"
        ],
        "pin": {
          "take-control": {
            "label": "Viewing · Take back",
            "tooltip": "Someone else has the keyboard and mouse; take them back",
            "tone": "accent"
          },
          "stream": { "active": true, "tone": "accent" }
        },
        "menu": {
          "control": "stream",
          "rows": ["codec", "fps", "overlay", "transport", "codec-note"],
          "pin": {
            "fps": {
              "value": "60",
              "options": [
                { "value": "60", "label": "60 fps", "disabled": false },
                { "value": "90", "label": "90 fps", "disabled": false },
                { "value": "120", "label": "120 fps", "disabled": false }
              ],
              "editable": true,
              "disabled": true,
              "tooltip": "Only the session with the controls changes the frame rate"
            },
            "overlay": {
              "value": "1",
              "disabled": true,
              "tooltip": "Only the session with the controls changes the overlay"
            }
          }
        }
      }
    },
    {
