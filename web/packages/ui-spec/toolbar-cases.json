        "visible": true,
        "controls": [
          "back", "power", "share", "name", "gpu", "stream", "capture", "mouse", "sound", "controllers",
          "fullscreen", "stats"
        ],
        "pin": {
          "capture": {
            "icon": "exclusive-input-on",
            "aria_label": "Exclusive input on",
            "tooltip": "Exclusive input on: clicking the picture captures the mouse; click here to turn that off",
            "pressed": true,
            "disabled": false,
            "tone": "accent"
          }
        }
      }
    },
    {
