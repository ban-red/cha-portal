      }
    },
    {
      "name": "web: mouse off disables exclusive input",
      "platforms": ["web"],
      "caps": "web-portal",
      "state": { "mouse_on": false },
      "expect": {
        "visible": true,
        "controls": [
          "back", "power", "share", "name", "gpu", "stream", "capture", "mouse", "sound", "controllers",
          "fullscreen", "stats"
        ],
        "pin": {
          "mouse": {
            "icon": "mouse-off",
            "aria_label": "Turn the mouse on",
            "tooltip": "Mouse off: click to send the mouse again",
            "pressed": true,
            "tone": "warn"
          },
          "capture": {
            "icon": "exclusive-input",
            "tooltip": "Turn the mouse on to use exclusive input",
            "pressed": false,
            "disabled": true,
            "tone": "none"
          }
        }
      }
    },
    {
      "name": "web: exclusive input on after the browser let go",
      "platforms": ["web"],
      "caps": "web-portal",
      "state": { "recapture": true },
