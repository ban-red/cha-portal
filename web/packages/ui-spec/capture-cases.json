    },
    {
      "name": "losing the capture mid-hold cancels the hold; the key-up goes to the host",
      "steps": [
        {
          "t": 0,
          "ev": "down",
          "host": "down"
        },
        {
          "t": 400,
          "ev": "uncapture"
        },
        {
          "t": 1500,
          "ev": "tick"
        },
        {
          "t": 1600,
          "ev": "up",
          "host": "up"
        }
      ]
    },
    {
      "name": "a key-up that arrives after the timer should have fired still releases, once",
      "steps": [
        {
          "t": 0,
          "ev": "down",
          "host": "down"
        },
        {
          "t": 1200,
          "ev": "up",
          "host": "up",
          "release": true
        }
      ]
    },
    {
      "name": "a new press after a lost key-up starts a new hold",
      "steps": [
        {
          "t": 0,
          "ev": "down",
          "host": "down"
        },
        {
          "t": 1000,
          "ev": "tick",
          "host": "up",
          "release": true
        },
        {
          "t": 1500,
          "ev": "down",
          "host": "down"
        },
        {
          "t": 1600,
          "ev": "up",
          "host": "up"
        }
      ]
    },
    {
      "name": "a repeat with no press before it is dropped",
      "steps": [
        {
          "t": 0,
          "ev": "repeat"
        },
        {
          "t": 100,
          "ev": "up",
          "host": "up"
        }
      ]
    },
    {
      "name": "a long stall between events does not fire early or twice",
      "steps": [
        {
          "t": 0,
          "ev": "down",
          "host": "down"
        },
        {
          "t": 5000,
          "ev": "tick",
          "host": "up",
          "release": true
        },
        {
          "t": 5001,
          "ev": "tick"
        },
        {
