        },
        {
          "t": 1100,
          "ev": "up"
        },
        {
          "t": 2000,
          "ev": "down",
          "host": "down"
        },
        {
          "t": 2300,
          "ev": "tick",
          "hint": 0.3
        },
        {
          "t": 3000,
          "ev": "tick",
          "host": "up",
          "release": true
        },
        {
          "t": 3100,
          "ev": "up"
        }
      ]
    },
    {
      "name": "recapturing while Esc is still held: the repeats and the key-up stay ours",
      "steps": [
        {
          "t": 0,
          "ev": "down",
          "host": "down"
        },
        {
          "t": 1000,
          "ev": "tick",
          "host": "up",
          "release": true
        },
        {
          "t": 1500,
          "ev": "repeat"
        },
        {
          "t": 1600,
          "ev": "up"
        },
        {
          "t": 1700,
          "ev": "down",
          "host": "down"
        },
        {
          "t": 1800,
          "ev": "up",
          "host": "up"
        }
      ]
    },
    {
      "name": "not captured: Esc goes to the host as usual, with no hold",
      "steps": [
        {
          "t": 0,
          "ev": "down",
          "captured": false,
          "host": "down"
        },
        {
          "t": 2000,
          "ev": "tick"
        },
        {
          "t": 2100,
          "ev": "up",
          "host": "up"
        }
      ]
    },
    {
      "name": "not captured: repeats are dropped too",
      "steps": [
        {
          "t": 0,
          "ev": "down",
          "captured": false,
          "host": "down"
        },
        {
          "t": 500,
          "ev": "repeat",
          "captured": false
