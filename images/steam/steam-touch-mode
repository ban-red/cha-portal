#!/usr/bin/python3
"""Keeps gamescope's touch click mode out of "passthrough" and "disabled".

gamescope runs here as a Wayland client of our compositor, and its Wayland
backend hands the host's pointer to its input code as touch motion. What that
does depends on gamescope's touch click mode, which Steam sets on the root
window of gamescope's X server (STEAM_TOUCH_CLICK_MODE):
- in Big Picture Steam sets 4, "passthrough": touches go to the app as touches.
  The host pointer's motion is then dropped, because no touch is down: the X
  pointer stays where Steam parked it (the bottom right corner), clicks land
  there, and the UI never gets a field to type into;
- 5 is "disabled": dropped too.
Every other mode (0 hover, 1 left, 2 right, 3 middle, 6 trackpad) moves the
pointer. This puts gamescope's own default, 1, back whenever Steam sets 4 or 5.
There is no touchscreen in an environment, so nothing is lost.

Run it with gamescope's X server in $DISPLAY; it ends when that goes away.
"""

import ctypes
import time

PROPERTY_NOTIFY = 28
PROPERTY_CHANGE_MASK = 1 << 22
CARDINAL = 6
PASSTHROUGH, DISABLED, LEFT = 4, 5, 1

x11 = ctypes.CDLL("libX11.so.6")
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XDefaultRootWindow.restype = ctypes.c_ulong
x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XInternAtom.restype = ctypes.c_ulong
x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x11.XSelectInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_long]
x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
x11.XFree.argtypes = [ctypes.c_void_p]
x11.XFlush.argtypes = [ctypes.c_void_p]
x11.XChangeProperty.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong,
    ctypes.c_int, ctypes.c_int, ctypes.c_void_p, ctypes.c_int,
]
x11.XGetWindowProperty.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_long, ctypes.c_long,
    ctypes.c_int, ctypes.c_ulong, ctypes.c_void_p, ctypes.c_void_p,
    ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p,
]


class PropertyEvent(ctypes.Structure):
    _fields_ = [
        ("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
        ("display", ctypes.c_void_p), ("window", ctypes.c_ulong), ("atom", ctypes.c_ulong),
        ("time", ctypes.c_ulong), ("state", ctypes.c_int),
    ]


class Event(ctypes.Union):
    _fields_ = [("type", ctypes.c_int), ("property", PropertyEvent), ("pad", ctypes.c_long * 24)]


def mode(display, root, atom):
    """The property's value, or None while it isn't set."""
    kind, fmt = ctypes.c_ulong(), ctypes.c_int()
    count, left, data = ctypes.c_ulong(), ctypes.c_ulong(), ctypes.c_void_p()
    x11.XGetWindowProperty(
        display, root, atom, 0, 1, 0, CARDINAL,
        ctypes.byref(kind), ctypes.byref(fmt), ctypes.byref(count), ctypes.byref(left), ctypes.byref(data),
    )
    value = None
    if data.value:
        if fmt.value == 32 and count.value == 1:
            value = ctypes.cast(data.value, ctypes.POINTER(ctypes.c_ulong))[0]
        x11.XFree(data)
    return value


def main():
    # gamescope's X server is up before it starts its child, but be patient.
    for _ in range(100):
        display = x11.XOpenDisplay(None)
        if display:
            break
        time.sleep(0.1)
    else:
        raise SystemExit("steam-touch-mode: no X display")
    root = x11.XDefaultRootWindow(display)
    atom = x11.XInternAtom(display, b"STEAM_TOUCH_CLICK_MODE", 0)
    x11.XSelectInput(display, root, PROPERTY_CHANGE_MASK)

    def fix():
        if mode(display, root, atom) in (PASSTHROUGH, DISABLED):
            left = ctypes.c_ulong(LEFT)
            x11.XChangeProperty(display, root, atom, CARDINAL, 32, 0, ctypes.byref(left), 1)
            x11.XFlush(display)

    # Steam may have set it before we looked; then whenever it does.
    fix()
    event = Event()
    while True:
        x11.XNextEvent(display, ctypes.byref(event))
        if event.type == PROPERTY_NOTIFY and event.property.atom == atom:
            fix()


if __name__ == "__main__":
    main()
