#!/bin/sh
# The Steam environment's one-time setup, then steam-session, which runs Steam
# in gamescope (Big Picture, steam-gaming) or in an XFCE desktop (steam-desktop)
# and switches between them, as SteamOS does between Gaming Mode and Desktop
# Mode. The container lives as long as steam-session does.
set -eu
# The node lays each user's own folders over parts of the shared library
# (CHA_PER_USER_DIRS: Proton's prefixes and shader caches); if they aren't
# mounted, Proton would work in the shared copies. Not even Steam starts.
steam-per-user-dirs || exit 1
# The node mounts what the admin shares across users and says where in
# CHA_SHARED_DIR (a library, often on a NAS). It is listed among Steam's library
# folders now, before Steam starts: Steam rewrites its list from memory while it
# runs, so a change then is lost. steam-library never writes in that directory.
if [ -n "${CHA_SHARED_DIR:-}" ]; then
  steam-library "$CHA_SHARED_DIR" || echo "start-steam: couldn't list the shared library" >&2
fi
# GTK 4's Vulkan renderer fails under gamescope's WSI layer (Steam's zenity
# dialogs crashed): GL instead.
export GSK_RENDERER=gl
# The performance overlay: gamescope starts mangoapp (--mangoapp), which draws
# in gamescope's picture and re-reads this file whenever it changes. Plain
# -gamepadui never offers Steam's overlay-level setting, so Steam doesn't write
# it: the streamer does, replacing the file atomically with `no_display` (off)
# or `mangoapp_steam` and `preset=1..4` (MangoHud draws nothing over Steam's own
# UI without mangoapp_steam). The presets are ~/.config/MangoHud/presets.conf in
# the home if it exists, else MangoHud's own. The file existing tells the
# streamer this app has an overlay. steam-session makes it (off) when it starts
# gaming mode and removes it in desktop mode, where nothing draws the overlay.
export MANGOHUD_CONFIGFILE=/run/cha/mangohud.conf
# steam-session clears Steam's stale pid file and pipe before every Steam
# start, runs each session under steam-run (which keeps its output in
# ~/.local/state/cha/gamescope.log and in the container's log, and when it dies
# on an error says so on the page and exits with its code) and ends with that
# code: the container ends, the environment fails and the node keeps the log
# tail. Nothing is restarted after a crash.
exec steam-session
