# cha-sandbox: Docker's default AppArmor profile (moby's docker-default), except
# that processes may mount and pivot inside user namespaces they create.
#
# Apps that build their own sandboxes with bubblewrap need that: Steam's
# pressure-vessel (every game, and Steam's web helper) and GTK's image
# loaders. Docker's default profile denies every mount, and on Ubuntu the
# host restricts unprivileged user namespaces besides. The container still has
# no capabilities and its seccomp profile; mounts can only happen in a
# namespace the app creates and owns, as under Podman's defaults.
#
# Install on the node (root), then check with `cha-node --doctor`:
#   sudo install -m 644 deploy/node/host/apparmor/cha-sandbox /etc/apparmor.d/cha-sandbox
#   sudo apparmor_parser -r -W /etc/apparmor.d/cha-sandbox
# Environments with the `steam` security profile run under it.

#include <tunables/global>

profile cha-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # The difference from docker-default: user namespaces, and mounts and
  # pivot_root inside them.
  userns,
  mount,
  pivot_root,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=cha-sandbox,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=cha-sandbox,
}
