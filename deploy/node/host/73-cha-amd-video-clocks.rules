# Cha Node: keep an AMD GPU's video engine at its top clock (installed by
# deploy/node/host/install.sh and deploy/proxmox/create-node.sh).
#
# On "auto" the encoder's clocks (vclk, dclk) stay at their lowest step under a
# 60 fps stream, whose encodes are short bursts: HEVC at 1440p took 7 ms a
# frame on a Radeon 780M, and 3.25 ms with these two clocks at their top, for
# no measurable power (docs/benchmarks/p2amd-2026-10-09-mini-titan-780m-node.json).
# "manual" with only pp_dpm_vclk and pp_dpm_dclk set leaves the 3D and memory
# clocks free to move as on "auto". Remove this file and reboot to undo.
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", DRIVERS=="amdgpu", RUN+="/bin/sh -c 'd=/sys%p/device; [ -w $$d/pp_dpm_vclk ] && [ -w $$d/pp_dpm_dclk ] || exit 0; echo manual >$$d/power_dpm_force_performance_level || exit 0; for c in vclk dclk; do echo $$(($$(wc -l <$$d/pp_dpm_$$c) - 1)) >$$d/pp_dpm_$$c; done'"
